NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/tamqo_logix?replicaSet=rs0
CLIENT_URL=http://127.0.0.1:5173

# Used once when no SUPER_ADMIN exists. Remove the password after bootstrap.
BOOTSTRAP_SUPER_ADMIN_NAME=
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# Legacy migration alternative: bcrypt hash generated by npm run admin:password.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Exactly 64 hexadecimal characters (32 random bytes). Keep it stable.
DELIVERY_CREDENTIALS_ENCRYPTION_KEY=
DELIVERY_API_BASE_URL=https://procolis.com/api_v1
# Legacy ABEX credentials are imported into its agency record during migration
# when the encryption key is configured. New credentials are saved through Settings.
DELIVERY_API_TOKEN=
DELIVERY_API_KEY=
DELIVERY_TIMEOUT_MS=15000
# JSON mapping of provider status strings to internal statuses; no guessed codes.
DELIVERY_STATUS_MAP={}
DELIVERY_SYNC_ENABLED=true
DELIVERY_SYNC_INTERVAL_MS=900000
