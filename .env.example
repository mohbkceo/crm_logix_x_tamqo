NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/tamqo_logix?replicaSet=rs0
CLIENT_URL=http://127.0.0.1:5173

# Backend-only Cloudinary credentials. Never prefix with VITE_ or include in client code.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Keep the existing durable volume mounted until migration and backups are verified.
# Default: server/storage/order-images
MEDIA_STORAGE_DIR=

# Used once when no SUPER_ADMIN exists. Remove the password after bootstrap.
BOOTSTRAP_SUPER_ADMIN_NAME=
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# Legacy migration alternative: bcrypt hash generated by npm run admin:password.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Exactly 64 hexadecimal characters (32 random bytes). Keep it stable.
DELIVERY_CREDENTIALS_ENCRYPTION_KEY=
# ABEX TMS credentials are entered per agency in Delivery agencies.
# Enable only after the agency connection and mappings have been verified.
ABEX_WRITES_ENABLED=false
# Inbound destination already exists. Start with reception/processing disabled.
# Backend-only Standard Webhooks secret: whsec_ + canonical base64 (>=32 bytes).
ABEX_WEBHOOK_ENABLED=true
ABEX_WEBHOOK_SECRET=whsec_wT2L6sXWZsHw9MlZA55j/AFDDvyIugu184YN/l1/vBU=
ABEX_WEBHOOK_DESTINATION_ID=00c7191e-83b7-43dd-beda-9d5425cf51d3
# Bind to the existing CRM ABEX agency ObjectId, never a payload agency ID.
ABEX_WEBHOOK_AGENCY_ID=00c7191e-83b7-43dd-beda-9d5425cf51d3
# Independent of delivery cron. Unknown contracts are recorded without mutations.
ABEX_WEBHOOK_PROCESSING_ENABLED=true
# Terminal event TTLs. Pending events never expire automatically.
ABEX_WEBHOOK_RETENTION_DAYS=30
ABEX_WEBHOOK_FAILED_RETENTION_DAYS=90
ABEX_WEBHOOK_MAX_ATTEMPTS=8
# Legacy Procolis fallback for the historical ABEX agency.
DELIVERY_API_BASE_URL=https://procolis.com/api_v1
DELIVERY_API_TOKEN=
DELIVERY_API_KEY=
DELIVERY_TIMEOUT_MS=15000
# Legacy Procolis status label overrides. ABEX TMS uses agency workflow IDs.
DELIVERY_STATUS_MAP={}
# Initial values only: cron, interval and logging are then managed in
# Settings / Delivery Sync Logs and stored in the database.
DELIVERY_SYNC_ENABLED=true
DELIVERY_SYNC_INTERVAL_MS=900000
