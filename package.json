{
  "name": "tamqo-logix-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:local": "node scripts/local-dev.js",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "seed": "npm run seed -w server",
    "test": "npm test -w server",
    "lint": "eslint .",
    "admin:password": "node scripts/password.js",
    "test:browser": "node scripts/browser-check.js",
    "test:delivery-browser": "node scripts/delivery-browser-check.js",
    "format": "prettier --write \"client/src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"scripts/*.js\"",
    "migrate": "node server/src/migrate.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "mongodb-memory-server": "^10.3.0",
    "prettier": "^3.9.6"
  }
}
